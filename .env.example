# Intelligent Document Intelligence Platform - Configuration

# Environment
ENV=development
DEBUG=True

# Database Configuration
# Default: SQLite for instant zero-dependency live run
# To connect to Cloud PostgreSQL (Neon / Supabase / Railway), uncomment and set DATABASE_URL:
# DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/docintel?sslmode=require
DATABASE_URL=sqlite:///./database/docintel.db

# Security & Tokens
JWT_SECRET=super-secret-prototype-jwt-key-hs03-docintel
PASSWORD_SALT=prototype_salt_HS03

# LLM & Embedding API Keys (Optional - Intelligent fallback is built-in)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIzaSy...

# Retrieval & Thresholds
CONFIDENCE_GATE_THRESHOLD=0.35
HIGH_CONFIDENCE_THRESHOLD=0.80
MEDIUM_CONFIDENCE_THRESHOLD=0.50
OCR_CONFIDENCE_THRESHOLD=0.60
